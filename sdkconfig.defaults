# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# The board is an ESP32-S3-WROOM-1 N16R8; ESP-IDF's 2MB default is not the
# hardware, and the largest built-in table was already 92% full. See partitions.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
# ESP-IDF resolves a relative CSV against its PROJECT_DIR, which esp-idf-sys
# generates six levels down at target/<triple>/<profile>/build/<pkg>/out --
# hence the climb back to the repo root. Needs revisiting only if the target
# directory is ever moved out of the tree with CARGO_TARGET_DIR.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms by default).
#CONFIG_FREERTOS_HZ=1000

# Workaround for https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n


# WebSocket
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_COMP_TCP_TRANSPORT_ENABLED=y
CONFIG_COMP_ESP_TLS_ENABLED=y

# PSRAM
# The module is an ESP32-S3-WROOM-1 N16R8: 8 MB of octal PSRAM that was sitting
# idle while every allocation competed for the ~400 KB of internal SRAM, of
# which 108 KB is already committed to task stacks. The PSRAM pins (GPIO 33-37)
# are internal to the module, so there is no clash with the display (7/6/5/4/48),
# the touch bus (8/18) or the LEDs (39/40/41).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# PSRAM is not DMA-capable here and is slower on a cache miss, so keep small
# allocations - which is most driver bookkeeping - in internal RAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
